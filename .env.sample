# Copy to .env and edit as needed
PORT=8080
DB_CLIENT=sqlite3 # or mysql
# For sqlite keep a local file path (relative to backend/)
DB_CONNECTION=./data/vitacora.sqlite

# MySQL / MariaDB vars (used when DB_CLIENT=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=vitacora
MYSQL_ROOT_PASSWORD=changeme

# App
NODE_ENV=development
