# Copy to .env and edit as needed
PORT=8080
DB_CLIENT=sqlite3 # or mysql
# For sqlite keep a local file path (relative to backend/)
DB_CONNECTION=./data/vitacora.sqlite

# MySQL / MariaDB vars (used when DB_CLIENT=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=vitacora
MYSQL_ROOT_PASSWORD=changeme

# App
NODE_ENV=development

# Auth (opt-in)
AUTH_ENABLED=false
# AUTH_BYPASS_TOKEN removed from sample for security. Use a secure secret store in CI/deploy.
# To enable quick test mode only in ephemeral dev, set AUTH_BYPASS_TOKEN in your local .env (do NOT commit).
JWT_SECRET=replace-with-long-random-secret

# Backups
BACKUP_PATH=./backups
